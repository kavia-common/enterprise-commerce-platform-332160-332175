# ============================================================
# Enterprise Commerce Platform - Backend Express.js
# Environment Configuration
# ============================================================
# Copy this file to .env and adjust values for your environment.
# The application reads all config from src/config/index.js,
# which sources values from these environment variables.
# ============================================================

# ── Server ──
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── Database (PostgreSQL) ──
# Connection string matching database_postgresql/db_connection.txt
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://appuser:dbuser123@localhost:5000/myapp

# ── JWT Authentication ──
# IMPORTANT: Change JWT_SECRET in production to a strong random string
JWT_SECRET=enterprise-commerce-jwt-secret-dev-only
JWT_EXPIRES_IN=24h

# ── Cross-Service URLs ──
# FRONTEND_URL: The URL where the frontend (Next.js) is served.
#   Automatically added to CORS allowed origins.
#   The frontend uses NEXT_PUBLIC_API_BASE (or NEXT_PUBLIC_BACKEND_URL) 
#   pointing back to this backend.
FRONTEND_URL=http://localhost:3000
# BACKEND_URL: This backend's own externally-reachable URL (for docs/links)
BACKEND_URL=http://localhost:3001
# SITE_URL: Legacy alias for FRONTEND_URL (used for redirects)
SITE_URL=http://localhost:3000

# ── CORS Configuration ──
# Comma-separated list of allowed origins for cross-origin requests.
# FRONTEND_URL is automatically merged into this list.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=100

# ── Logging ──
# Levels: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# ============================================================
# Seed Data (for reference — not env vars, just documentation)
# ============================================================
# Admin:    admin@enterprise.com    / Admin123!
# Customer: customer@example.com    / Admin123!
#
# The backend automatically verifies seed password hashes
# at startup and re-hashes with bcryptjs if needed.
# ============================================================
#
# Frontend Integration:
#   The Next.js frontend should set:
#     NEXT_PUBLIC_API_BASE=<this backend URL>  (e.g., http://localhost:3001)
#   or
#     NEXT_PUBLIC_BACKEND_URL=<this backend URL>
#
# API Documentation:
#   Swagger UI:  http://localhost:3001/docs
#   OpenAPI JSON: http://localhost:3001/openapi.json
# ============================================================
